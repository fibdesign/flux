{
  "name": "flux",
  "version": "0.3.0",
  "bin": {
    "flux": "dist/flux-cli.js"
  },
  "type": "commonjs",
  "pkg": {
    "assets": [
      "assets/**/*",
      "stubs/**/*",
      "views/**/*"
    ],
    "scripts": [
      "dist/**/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "release"
  },
  "license": "MIT",
  "scripts": {
    "build": "remove.bat && tsc",
    "copy": "copy.bat",
    "pkg": "pkg . --icon assets/icon.ico && npm run copy",
    "compile": "npm run build && npm run pkg"
  },
  "dependencies": {
    "fs-extra": "^11.3.0",
    "node-watch": "^0.7.4",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.3",
    "typescript": "^5.8.3"
  }
}
